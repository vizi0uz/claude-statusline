# Shell scripts MUST stay LF — CRLF breaks the shebang on Linux/macOS
# ("#!/bin/bash\r" -> bad interpreter). Enforced regardless of core.autocrlf.
*.sh text eol=lf

# PowerShell runs fine with either ending; pin to CRLF for native Windows editing.
*.ps1 text eol=crlf

# Everything else: let Git normalize to LF in the repo.
* text=auto
